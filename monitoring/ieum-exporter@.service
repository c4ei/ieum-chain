[Unit]
Description=IEUM Prometheus exporter (%i)
After=network-online.target ieum-chain.service

[Service]
Type=simple
User=dev
EnvironmentFile=/etc/ieum/exporter-%i.env
ExecStart=/usr/bin/python3 /opt/ieum-chain/monitoring/ieum_exporter.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
